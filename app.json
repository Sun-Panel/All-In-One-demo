{
  "appJsonVersion": "1.0",
  "microAppId": "sun-panel-all-in-one-demo",
  "version": "1.0.0",
  "apiVersion": "1.0.15",
  "author": "sun-panel",
  "entry": "main.js",
  "icon": "logo.png",
  "components": {
    "pages": {
      "counter-widget-config-page": {
        "background": "#ffffff"
      },
      "window-demo-page": {
        "background": "#ffffff"
      },
      "data-node-test-page": {
        "background": "#ffffff"
      },
      "network-test-page": {
        "background": "#ffffff"
      },
      "context-info-page": {
        "background": "#ffffff"
      }
    },
    "widgets": {
      "context-info-widget": {
        "configComponentName": null,
        "size": [
          "2x4"
        ],
        "background": "",
        "isModifyBackground": false
      },
      "counter-widget": {
        "configComponentName": "counter-widget-config-page",
        "size": [
          "1x1",
          "2x2"
        ],
        "background": "",
        "isModifyBackground": false
      },
      "user-cache-widget": {
        "configComponentName": null,
        "size": [
          "2x4"
        ],
        "background": "",
        "isModifyBackground": false
      },
      "other-widget": {
        "configComponentName": null,
        "size": [
          "2x4"
        ],
        "background": "white",
        "isModifyBackground": false
      },
      "window-manager-widget": {
        "configComponentName": null,
        "size": [
          "2x4"
        ],
        "background": "white",
        "isModifyBackground": false
      },
      "lifecycle-widget": {
        "configComponentName": null,
        "size": [
          "2x4"
        ],
        "background": "",
        "isModifyBackground": false
      }
    }
  },
  "permissions": [
    "network",
    "dataNode",
    "iframe"
  ],
  "dataNodes": {
    "appConfig": {
      "scope": "app",
      "isPublic": true
    },
    "apiKey": {
      "scope": "app",
      "isPublic": false
    },
    "userSettings": {
      "scope": "user",
      "isPublic": true
    },
    "privateData": {
      "scope": "user",
      "isPublic": false
    },
    "networkConfig": {
      "scope": "user",
      "isPublic": false
    },
    "cookieStore": {
      "scope": "user",
      "isPublic": false
    }
  },
  "networkDomains": [
    "api.example.com",
    "jsonplaceholder.typicode.com"
  ],
  "appInfo": {
    "zh-CN": {
      "appName": "AllInOne Demo",
      "description": "包含所有微应用功能的演示应用",
      "networkDescription": "用于测试网络请求功能"
    },
    "en-US": {
      "appName": "AllInOne Demo",
      "description": "Demo app with all micro app features",
      "networkDescription": "For testing network request functionality"
    }
  }
}